<Window x:Class="lab05.GunsList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:lab05"
        Title="Products"
        SizeToContent="Height"
        MinHeight="400"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}">

    <Window.Resources>

        <local:DiscountConverter x:Key="DiscountConverter"/>
        <local:HighlightConverter x:Key="HighlightConverter"/>

        <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ButtonsColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource TextboxColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonsColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

    </Window.Resources>

    <Grid Margin="10"
          Background="{DynamicResource BackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="{DynamicResource GunListSearchBy}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>

                    <ComboBox Width="120" Margin="0,0,5,0" Name="SearchCombo">
                        <ComboBoxItem Content="{DynamicResource GunListName}"/>
                        <ComboBoxItem Content="{DynamicResource GunListCategory}"/>
                        <ComboBoxItem Content="{DynamicResource GunListCountry}"/>
                    </ComboBox>

                    <TextBox Width="200" Name="SearchText"/>
                    
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource GunListSortBy}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>

                    <ComboBox Width="150" Name="SortByCombobox" SelectionChanged="SortCardsBy">
                        <ComboBoxItem Content="{DynamicResource GunListPrice}"/>
                        <ComboBoxItem Content="{DynamicResource GunListDiscount}"/>
                        <ComboBoxItem Content="{DynamicResource GunListQuantity}"/>
                    </ComboBox>

                    <ComboBox Width="150" Name="HowSortCombobox" SelectionChanged="SortCardsBy">
                        <ComboBoxItem Content="{DynamicResource GunListAscending}"/>
                        <ComboBoxItem Content="{DynamicResource GunListDescending}"/>
                    </ComboBox>
                </StackPanel>

            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button x:Name="UserMenu"
                        Margin="0,0,10,0"
                        Content="{DynamicResource GunListAccount}"
                        Click="UserMenu_click"/>
                
                <Button x:Name="ReturnButton"
                        Margin="0,0,10,0"
                        Content="{DynamicResource UserMenuBack}"
                        Click="ReturnButton_Click"/>

                <TextBlock x:Name="RoleText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentColor}"
                           Margin="0,0,10,0"/>

                <Button x:Name="AddButton"
                        Content="{DynamicResource GunListAdd}"
                        Width="90"
                        Margin="5"
                        Click="AddButton_Click"/>

                <Button x:Name="DeleteButton"
                        Content="{DynamicResource GunListDelete}"
                        Width="90"
                        Margin="5"
                        Click="DeleteButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">

            <ItemsControl x:Name="GunsListControl"
                          ItemsSource="{Binding Guns}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        
                        <Border CornerRadius="10"
                                Height="240"
                                Padding="8"
                                Margin="6"
                                PreviewMouseLeftButtonDown="Button_MouseDown">


                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <Border.Triggers>

                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1.06"
                                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1.06"
                                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0.95"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1.0"
                                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1.0"
                                                             Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="1.0"
                                                             Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                
                                <EventTrigger RoutedEvent="MouseLeftButtonDown">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0.6"
                                                             Duration="0:0:0.05"
                                                             AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>

                            </Border.Triggers>
                            
                            <Border.Style>
                                <Style TargetType="Border">

                                    <Setter Property="Background"
                                            Value="{DynamicResource ButtonsColor}"/>

                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource WindowBorderBrush}"/>

                                    <Setter Property="BorderThickness"
                                            Value="1"/>

                                    <Style.Triggers>

                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource HighlightConverter}">
                                                    <Binding Path="discount"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>

                                            <Setter Property="Background"
                                                    Value="{DynamicResource DiscountAccentColor}"/>
                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </Border.Style>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource BackgroundColor}"
                                        CornerRadius="6">
                                    <Image Source="{Binding imagePath[0]}"
                                           Stretch="UniformToFill"
                                           Height="100"/>
                                </Border>

                                <TextBlock Text="{Binding name}"
                                           FontWeight="Bold"
                                           Grid.Row="1"/>

                                <TextBlock Text="{Binding description}"
                                           Grid.Row="2"
                                           TextWrapping="Wrap"/>

                                <StackPanel Grid.Row="3">

                                    <TextBlock Text="{Binding price}"/>
                                    <TextBlock Text="{Binding discount, StringFormat={}{0}%}"/>

                                </StackPanel>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>


            <TextBlock Text="Товаров нет"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentColor}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=GunsListControl, Path=HasItems}"
                                         Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>

            </TextBlock>

        </Grid>

    </Grid>
</Window>