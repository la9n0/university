<Window x:Class="lab05.AddProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AddProductTitle}"
        Height="650" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="15">

        <Border Background="White"
                CornerRadius="10"
                Padding="15"
                BorderBrush="#DDD"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="{DynamicResource AddProductNewProduct}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="{DynamicResource AddProductShortName}"/>
                    <TextBox x:Name="NameBox" Margin="0,5,0,10"/>

                    <TextBlock Text="{DynamicResource AddProductFullName}"/>
                    <TextBox x:Name="FullNameBox" Margin="0,5,0,10"/>

                    <TextBlock Text="{DynamicResource AddProductDescription}"/>
                    <TextBox x:Name="DescriptionBox" Margin="0,5,0,10"/>

                    <TextBlock Text="{DynamicResource AddProductFullDescription}"/>
                    <TextBox x:Name="FullDescriptionBox"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,5,0,10"/>

                    <TextBlock Text="{DynamicResource AddProductCategory}"/>
                    <ComboBox x:Name="CategoryBox" Margin="0,5,0,10">
                        <ComboBoxItem Content="{DynamicResource AddProductCategoryColdWeapons}"/>
                        <ComboBoxItem Content="{DynamicResource AddProductCategoryPistols}"/>
                        <ComboBoxItem Content="{DynamicResource AddProductCategorySmg}"/>
                        <ComboBoxItem Content="{DynamicResource AddProductCategoryRifles}"/>
                        <ComboBoxItem Content="{DynamicResource AddProductCategoryShotguns}"/>
                        <ComboBoxItem Content="{DynamicResource AddProductCategorySniperRifles}"/>
                        <ComboBoxItem Content="{DynamicResource AddProductCategoryAmmo}"/>
                    </ComboBox>

                    <Grid Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource AddProductPrice}"/>
                            <TextBox x:Name="PriceBox" PreviewTextInput="OnlyFloat"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource AddProductQuantity}"/>
                            <TextBox x:Name="QuantityBox" PreviewTextInput="OnlyInt"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource AddProductCountry}"/>
                            <TextBox x:Name="CountryBox"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource AddProductDiscount}"/>
                            <TextBox x:Name="DiscountBox" PreviewTextInput="OnlyFloat"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{DynamicResource AddProductImages}"/>

                    <Button Content="{DynamicResource AddProductSelectFiles}"
                            Height="30"
                            Margin="0,5,0,5"
                            Click="SelectImages_Click"/>

                    <Border BorderBrush="#CCC"
                            BorderThickness="1"
                            CornerRadius="5"
                            Height="100">

                        <ListBox x:Name="ImagesList"
                                 BorderThickness="0"/>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,15,0,0">

                        <Button Content="{DynamicResource AddProductCancel}"
                                Width="100"
                                Margin="0,0,10,0"
                                Click="CancelButton_Click"/>

                        <Button Content="{DynamicResource AddProductCreate}"
                                Width="120"
                                Background="#4CAF50"
                                Foreground="White"
                                Click="CreateButton_Click"/>
                    </StackPanel>

                </StackPanel>

            </ScrollViewer>
        </Border>
    </Grid>
</Window>