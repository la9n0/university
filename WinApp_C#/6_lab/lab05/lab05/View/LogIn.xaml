<Window x:Class="lab05.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="250" Width="300"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="{DynamicResource LogInLoginLabel}"/>
            <TextBox x:Name="LoginBox" Margin="0,5"/>

            <TextBlock Text="{DynamicResource LogInPasswordLabel}"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,5"/>

            <Button Content="{DynamicResource LogInLoginButton}"
                    Height="30"
                    Margin="0,10,0,0"
                    Click="Login_Click"/>

            <TextBlock x:Name="Error"
                       Text="{DynamicResource LogInErrorText}"
                       TextAlignment="Center"
                       Visibility="Hidden"/>
        </StackPanel>

        <!-- Язык -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <TextBlock Text="{DynamicResource LanguageLabel}"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0"/>

            <ComboBox x:Name="LanguageCombo"
                      Width="100"
                      SelectionChanged="LanguageCombo_SelectionChanged">
                <ComboBoxItem Content="Русский"/>
                <ComboBoxItem Content="English"/>
            </ComboBox>

        </StackPanel>
        
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0">

            <Button Content="{DynamicResource LogInRegistration}"
                    Click="RegistrationButton_click"
                    />


        </StackPanel>

    </Grid>
</Window>