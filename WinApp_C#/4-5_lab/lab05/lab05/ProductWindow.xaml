<Window x:Class="lab05.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар"
        Height="700" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верх -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="NameText"
                       FontSize="22"
                       FontWeight="Bold"/>
            
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button x:Name="EditButton"
                        Content="{DynamicResource Edit}"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Click="EditButton_Click"/>
                
                <Button x:Name="SaveButton"
                        Content="{DynamicResource Save}"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Click="SaveButton_Click"/>

                <Button x:Name="CancelButton"
                        Content="{DynamicResource Cancel}"
                        Visibility="Collapsed"
                        Click="CancelEdit_Click"/>

                <TextBlock x:Name="RoleText"
                           Foreground="Blue"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- изображения -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,10,0">

                <Image x:Name="MainImage"
                       Height="250"
                       Stretch="Uniform"/>
            </Border>

            <StackPanel Grid.Column="1">

                <Border Background="White" CornerRadius="8" Margin="0,0,0,5">
                    <Image x:Name="Img1"
                           Height="70"
                           Stretch="UniformToFill"
                           MouseDown="Image_Click"/>
                </Border>

                <Border Background="White" CornerRadius="8" Margin="0,0,0,5">
                    <Image x:Name="Img2"
                           Height="70"
                           Stretch="UniformToFill"
                           MouseDown="Image_Click"/>
                </Border>

                <Border Background="White" CornerRadius="8">
                    <Image x:Name="Img3"
                           Height="70"
                           Stretch="UniformToFill"
                           MouseDown="Image_Click"/>
                </Border>

            </StackPanel>
        </Grid>

        <!-- инфо -->
        <ScrollViewer Grid.Row="2">
            <StackPanel>

                <StackPanel.Resources>
                    <Style TargetType="Border">
                        <Setter Property="Margin" Value="0,5"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </StackPanel.Resources>

                <Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ProductNameLabel}"/>
                        <TextBox x:Name="NameBox"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Border>

                <Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ProductPriceLabel}"/>
                        <TextBox x:Name="PriceBox"
                                 PreviewTextInput="OnlyFloat"/>
                    </StackPanel>
                </Border>

                <Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ProductDescriptionLabel}"/>
                        <TextBox x:Name="DescriptionBox"/>
                    </StackPanel>
                </Border>

                <Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ProductCategoryLabel}"/>
                        <TextBox x:Name="CategoryBox"/>
                    </StackPanel>
                </Border>

                <Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ProductDiscountLabel}"/>
                        <TextBox x:Name="DiscountBox"
                                 PreviewTextInput="OnlyFloat"/>
                    </StackPanel>
                </Border>

                <Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ProductQuantityLabel}"/>
                        <TextBox x:Name="QuantityBox"
                                 PreviewTextInput="OnlyInt"/>
                    </StackPanel>
                </Border>

                <Border>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ProductCountryLabel}"/>
                        <TextBox x:Name="CountryBox"
                                 PreviewTextInput="OnlyString"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>