<Window x:Class="lab05.AddProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление товара"
        Height="650" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="15">

        <Border Background="White"
                CornerRadius="10"
                Padding="15"
                BorderBrush="#DDD"
                BorderThickness="1">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="Новый товар"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Краткое название"/>
                    <TextBox x:Name="NameBox" Margin="0,5,0,10"/>

                    <TextBlock Text="Полное название"/>
                    <TextBox x:Name="FullNameBox" Margin="0,5,0,10"/>

                    <TextBlock Text="Описание"/>
                    <TextBox x:Name="DescriptionBox" Margin="0,5,0,10"/>

                    <TextBlock Text="Полное описание"/>
                    <TextBox x:Name="FullDescriptionBox"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Margin="0,5,0,10"/>

                    <TextBlock Text="Категория"/>
                    <ComboBox x:Name="CategoryBox" Margin="0,5,0,10">
                        <ComboBoxItem Content="Холодое оружие"/>
                        <ComboBoxItem Content="Пистолеты"/>
                        <ComboBoxItem Content="Пистолеты-пулемёты"/>
                        <ComboBoxItem Content="Автоматы"/>
                        <ComboBoxItem Content="Дробовики"/>
                        <ComboBoxItem Content="Снайперские винтовки"/>
                        <ComboBoxItem Content="Патроны"/>
                    </ComboBox>

                    <Grid Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Цена"/>
                            <TextBox x:Name="PriceBox" PreviewTextInput="OnlyFloat"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Количество"/>
                            <TextBox x:Name="QuantityBox" PreviewTextInput="OnlyInt"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,5,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Страна производства"/>
                            <TextBox x:Name="CountryBox" PreviewTextInput="OnlyString"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Скидка (%)"/>
                            <TextBox x:Name="DiscountBox" PreviewTextInput="OnlyFloat"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Изображения"/>

                    <Button Content="Выбрать файлы"
                            Height="30"
                            Margin="0,5,0,5"
                            Click="SelectImages_Click"/>

                    <Border BorderBrush="#CCC"
                            BorderThickness="1"
                            CornerRadius="5"
                            Height="100">

                        <ListBox x:Name="ImagesList"
                                 BorderThickness="0"/>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,15,0,0">

                        <Button Content="Отмена"
                                Width="100"
                                Margin="0,0,10,0"
                                Click="CancelButton_Click"/>

                        <Button Content="Создать"
                                Width="120"
                                Background="#4CAF50"
                                Foreground="White"
                                Click="CreateButton_Click"/>
                    </StackPanel>

                </StackPanel>

            </ScrollViewer>
        </Border>
    </Grid>
</Window>